{
  "name": "Visio",
  "name_prefix": "Twake",
  "slug": "visio",
  "version": "1.6.0",
  "type": "webapp",
  "licence": "AGPL-3.0",
  "icon": "assets/icon.svg",
  "categories": ["cozy"],
  "service_url_flag": "visio_service_url",
  "source": "https://github.com/cozy/cozy-lasuite-visio",
  "editor": "Cozy",
  "developer": {
    "name": "Twake Workplace",
    "url": "https://twake.app"
  },
  "routes": {
    "/": {
      "folder": "/",
      "index": "index.html",
      "public": true
    }
  },
  "intents": [
    {
      "action": "OPEN",
      "type": ["io.cozy.visio.rooms"],
      "href": "/intents"
    }
  ],
  "permissions": {
    "banners": {
      "description": "Required by the cozy-bar to display platform messages",
      "type": "io.cozy.banners",
      "verbs": ["GET", "PUT"]
    },
    "apps": {
      "description": "Required by the cozy-bar to display the icons of the apps",
      "type": "io.cozy.apps",
      "verbs": ["GET"]
    },
    "settings": {
      "description": "Required by the cozy-bar to display storage usage",
      "type": "io.cozy.settings",
      "verbs": ["GET"]
    },
    "files": {
      "description": "Required to get shortcuts",
      "type": "io.cozy.files",
      "verbs": ["GET"],
      "selector": "name",
      "values": ["Home"]
    },
    "rooms": {
      "description": "Required to open a video call room from an intent",
      "type": "io.cozy.visio.rooms",
      "verbs": ["GET"]
    }
  }
}
